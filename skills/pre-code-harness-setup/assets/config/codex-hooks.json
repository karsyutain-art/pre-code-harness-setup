{
  "description": "pre-code-harness-setup: 위험 명령·보호 파일 차단, 코드 크기 리밋, 완료 기준 게이트",
  "hooks": {
    "PreToolUse": [
      { "matcher": "^Bash$", "hooks": [{ "type": "command", "command": "bash \"$(git rev-parse --show-toplevel)/.harness/hooks/guard-bash.sh\"" }] },
      { "matcher": "^apply_patch$", "hooks": [{ "type": "command", "command": "bash \"$(git rev-parse --show-toplevel)/.harness/hooks/guard-paths.sh\"" }] }
    ],
    "PostToolUse": [
      { "matcher": "^apply_patch$", "hooks": [{ "type": "command", "command": "bash \"$(git rev-parse --show-toplevel)/.harness/hooks/code-limits.sh\" --hook" }] }
    ],
    "SessionStart": [
      { "hooks": [{ "type": "command", "command": "bash \"$(git rev-parse --show-toplevel)/.harness/hooks/session-brief.sh\"" }] }
    ],
    "Stop": [
      { "hooks": [{ "type": "command", "command": "bash \"$(git rev-parse --show-toplevel)/.harness/hooks/stop-gate.sh\"", "timeout": 900 }] }
    ]
  }
}
